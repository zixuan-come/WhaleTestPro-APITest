WHALE_BASE_URL=http://localhost:8001
WHALE_USERNAME=your_username
WHALE_PASSWORD=your_password

# 核心回归仅在可重置的隔离环境手动开启；录制/回放会创建本轮资产。
# WHALE_CORE_ALLOW_WRITES=1
# 后端可达的专用模拟服务，运行 scripts/perf_fixture_server.py；不要指向平台健康接口。
# WHALE_REPLAY_FIXTURE_BASE_URL=http://<专用夹具Host>:8090

# 仅在隔离环境手动开启。默认不会创建压测核心测试资产或发送压测流量。
# WHALE_PERF_CORE_ALLOW_WRITES=1
# WHALE_PERF_ALLOW_LOAD=1
# Worker/Locust 可达的专用模拟服务 Host，不能指向 WhaleShop 或其他真实业务。
# WHALE_PERF_FIXTURE_BASE_URL=http://<专用夹具Host>:8090
